# Browser Cache Rules — merge into public/.htaccess (local Apache/XAMPP)
# public/.htaccess is gitignored; apply these rules manually after each fresh clone/deploy.

<IfModule mod_expires.c>
    ExpiresActive On

    # Vite build output (content-hashed filenames) — 1 year
    <FilesMatch "\.(css|js)$">
        ExpiresDefault "access plus 1 year"
    </FilesMatch>

    # Images and media — 30 days
    ExpiresByType image/jpeg        "access plus 30 days"
    ExpiresByType image/png         "access plus 30 days"
    ExpiresByType image/webp        "access plus 30 days"
    ExpiresByType image/gif         "access plus 30 days"
    ExpiresByType image/svg+xml     "access plus 30 days"
    ExpiresByType image/x-icon      "access plus 7 days"

    # Fonts — 1 year
    ExpiresByType font/woff         "access plus 1 year"
    ExpiresByType font/woff2        "access plus 1 year"
    ExpiresByType font/ttf          "access plus 1 year"
    ExpiresByType application/font-woff  "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    # Vite CSS/JS — immutable (content hash guarantees freshness)
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Fonts — immutable
    <FilesMatch "\.(woff|woff2|ttf|eot|otf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Images — 30 days
    <FilesMatch "\.(jpg|jpeg|png|webp|gif|svg|ico|bmp)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>
